# Data and user databases — never in version control
data/
!tests/data/
*.db
*.db-wal
*.db-shm

# Archives, backups, generated output
_archive/
_backups/
*.bak
Tabella/output/

# Python cruft
__pycache__/
*.pyc
.pytest_cache/

# Windows/OneDrive noise
desktop.ini
Thumbs.db

# User data backups and test datasets
Observatum/BackUps/
Observatum/test data/
*.bak*
*bak_*

_dump/

# Check outputs and exports written to the project root
/*.txt
/*.xlsx
/*.csv

# One-off data-changing scripts -- kept locally, archived later
scripts/_oneoff/

# Published checklists (copyright, all rights reserved) -- built on the PC by
# scripts/build_checklists.py from the PDFs in data/checklists/ (already ignored above)
shared/checklists/*.csv
/*.pdf

# pytest --basetemp folder
.pytest_tmp/
